    "%@. Open the Android screen and check it is running, then try again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。请打开 Android 屏幕，确认它正在运行，然后重试。"
