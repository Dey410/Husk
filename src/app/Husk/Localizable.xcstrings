            "value" : "此 App 需要购买或授权后才能下载。"
          }
        }
      }
    },
    "Appearance" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外观"
          }
        }
      }
    },
    "Apps" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App"
          }
        }
      }
    },
    "Apps and Games" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 与游戏"
          }
        }
      }
    },
    "Apps and games open in a window you can move, resize and minimise to a dock, like LiveContainer's multitasking. Each app can override this in its own settings." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 和游戏会在窗口中打开，可以移动、调整大小，也可以最小化到程序坞，类似 LiveContainer 的多任务。每个 App 都可以在自己的设置中单独更改。"
          }
        }
      }
    },
    "Architecture" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "架构"
          }
        }
      }
    },
    "Architectures" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "架构"
          }
        }
      }
    },
    "Ask How Games Ran" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "询问游戏运行情况"
          }
        }
      }
    },
    "Ask about Android updates" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "询问 Android 更新"
          }
        }
      }
    },
    "Attach my log" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "附上我的日志"
          }
        }
      }
    },
    "Attach the sound device" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接声音设备"
