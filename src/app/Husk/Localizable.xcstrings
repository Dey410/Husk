        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 TrollStore 开启 JIT"
          }
        }
      }
    },
    "Turn On JIT with TrollStore at Launch" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启动时用 TrollStore 开启 JIT"
          }
        }
      }
    },
    "Turn on **Open Apps in Windows** in Settings. Apps then open in a window you can move, resize and minimise." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
