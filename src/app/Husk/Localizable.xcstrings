        }
      }
    },
    "Husk's Android runtime is about 760 MB. Android itself follows once it is installed." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Husk 的 Android 运行环境约为 760 MB。安装后会继续获取 Android 本身。"
          }
        }
