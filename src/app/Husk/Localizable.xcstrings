{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {
      "shouldTranslate" : false
    },
    " (and %lld more)" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（还有 %lld 个）"
          }
        }
      }
    },
    " · %@ left" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " · 剩余 %@"
          }
        }
      }
    },
    " · %lld/%lld files" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " · %lld/%lld 个文件"
          }
        }
      }
    },
    "%.0f fps" : {
      "shouldTranslate" : false
    },
    "%@ (web app)" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（网页 App）"
          }
        }
      }
    },
    "%@ Orientation and resolution apply the next time the game starts, and a game already running in this session needs Husk closed and opened again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 方向和分辨率会在下次启动游戏时生效；本次运行中已在运行的游戏需要关闭并重新打开 Husk。"
          }
        }
      }
    },
    "%@ closed the app on purpose (%@). Apps with anti-tamper or anti-cheat protection do this when they find they are not on a certified Android phone, which Husk cannot pretend to be for them." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 主动关闭了 App（%2$@）。带有防篡改或反作弊保护的 App 在发现自己不在经过认证的 Android 手机上时会这样做，而 Husk 无法替它们伪装成这样的手机。"
          }
        }
      }
    },
    "%@ did not answer (HTTP %lld)." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 没有响应（HTTP %2$lld）。"
          }
        }
      }
    },
    "%@ free on this device." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备可用空间 %@。"
          }
        }
      }
    },
    "%@ has been started in this run of Husk. Close Husk and open it again to restore saves." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本次运行的 Husk 已启动过 %@。请关闭 Husk 并重新打开以恢复存档。"
          }
        }
      }
    },
    "%@ has not saved anything yet." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 还没有保存任何内容。"
          }
        }
      }
    },
    "%@ is compressed inside its bundle, which Husk cannot unpack yet." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在安装包中是压缩的，Husk 暂时无法解包。"
          }
        }
      }
    },
    "%@ is gone from Android." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已从 Android 中移除。"
          }
        }
      }
    },
    "%@ is ready to launch." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已可以启动。"
          }
        }
      }
    },
    "%@ is still loaded and only one game can run per session. Husk closes; open it again and %@ starts by itself." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 仍在加载中，每次运行只能玩一个游戏。Husk 会关闭；重新打开后 %2$@ 会自动启动。"
          }
        }
      }
    },
    "%@ is still loaded, and a game cannot be unloaded once it has started. Close Husk with the button above, then open it again to play %@." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 仍在加载中，游戏一旦启动就无法卸载。请用上方的按钮关闭 Husk，然后重新打开以玩 %2$@。"
          }
        }
      }
    },
    "%@ of %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ / %@"
          }
        }
      }
    },
    "%@ opens by itself once Android has started." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android 启动后 %@ 会自动打开。"
          }
        }
      }
    },
    "%@ update" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 更新"
          }
        }
      }
    },
    "%@ was started in this session, and a game cannot be unloaded once it has started. Close Husk completely and open it again to run %@." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本次运行中已启动过 %1$@，游戏一旦启动就无法卸载。请完全关闭 Husk 并重新打开以运行 %2$@。"
          }
        }
      }
    },
    "%@ was started in this session. Close Husk completely and open it again to run %@." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本次运行中已启动过 %1$@。请完全关闭 Husk 并重新打开以运行 %2$@。"
